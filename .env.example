# Copy to .env for docker compose. Everything is optional except CIB_DOMAIN when you want a public certificate.
CIB_DOMAIN=board.example.org
# Retention and backups
CIB_RETENTION_DAYS=30
CIB_BACKUP_HOURS=24
CIB_BACKUPS_KEEP=14
# Single sign-on (OIDC with PKCE). Redirect URI to register: https://<CIB_DOMAIN>/api/auth/oidc/callback
#OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_LABEL=Sign in with Entra ID
#OIDC_DEFAULT_ROLE=viewer
#OIDC_ADMINS=alice@example.org
#OIDC_ALLOWED_DOMAINS=example.org
# Outbound webhooks for watchers and reviews
#CIB_WEBHOOK_URL=
# Provider keys stay on the server (never sent to the browser)
#VT_API_KEY=
#SHODAN_API_KEY=
#THREATFOX_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
